#!/bin/sh
# shimo-net Python 启动器：零 Node 依赖
DIR=$(cd "$(dirname "$0")" && pwd)
PY="${SHIMO_PYTHON:-}"
[ -z "$PY" ] && PY="$(command -v python3 2>/dev/null || true)"
[ -z "$PY" ] && PY=/usr/bin/python3
if [ ! -x "$PY" ]; then
  echo "需要 Python 3.9+：请安装 Xcode Command Line Tools（xcode-select --install）或设置 SHIMO_PYTHON" >&2
  exit 1
fi
exec "$PY" "$DIR/bin/shimo.py" "$@"
